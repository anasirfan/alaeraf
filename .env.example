# Copy this file to .env.local and fill in the values from your Supabase
# project's dashboard: Project Settings -> API.
#
# .env.local (and any other .env* file) is already git-ignored — only this
# .env.example file is meant to be committed, as documentation of what the
# app needs. Never put real keys in this file.

# Public — safe to expose to the browser. Used by lib/supabase/client.ts,
# lib/supabase/server.ts and middleware.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret — bypasses Row Level Security. Never prefix this with
# NEXT_PUBLIC_, never read it from a Client Component, never commit it.
# Used only by lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Enables the "Search your address" box + confirmation map on
# every address form (My Account, Checkout, Subscribe) — see
# components/address/AddressAutocomplete.tsx. Without this, those forms
# simply keep using the manual Latitude/Longitude fields + "Use my current
# location", exactly as before this existed — nothing breaks either way.
#
# Get a free key at myprojects.geoapify.com (Geoapify) — no billing card
# required for the free tier, unlike Google Maps. This value is exposed to
# the browser (NEXT_PUBLIC_) by design — Geoapify keys are meant to be used
# client-side — but should still be restricted to this site's domain(s)
# from the Geoapify dashboard before relying on it in production.
NEXT_PUBLIC_GEOAPIFY_API_KEY=
